# Mark Swift code as vendored so GitHub shows Rust as primary language
*.swift linguist-vendored
Sources/** linguist-vendored
Tests/** linguist-vendored
Package.swift linguist-vendored

# Keep the files checked by the desktop Prettier script LF on every platform.
apps/desktop-tauri/src/codex-overlay/**/*.ts text eol=lf
apps/desktop-tauri/src/codex-overlay/**/*.tsx text eol=lf
apps/desktop-tauri/src/codex-overlay/**/*.css text eol=lf

scripts/dev.sh text eol=lf
scripts/macos-windows-cross-build.sh text eol=lf
